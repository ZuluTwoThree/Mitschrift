# Kopieren nach .env (gitignoriert). Keine echten Werte ins Repo.
MITSCHRIFT_TOKEN=hier-openssl-rand-hex-32-eintragen
MODELS_DIR=/home/<nutzer>/mitschrift/models
# Backend des Adapters: whisper (Rollpuffer vor whisper-server) oder nemo (Realtime-Streaming von nemo-speech serve)
ASR_BACKEND=whisper
NEMO_ENDPOINTING_MS=700
LANGUAGE=de
WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
WHISPER_THREADS=8
WHISPER_ARGS=-sns -bs 5
WHISPER_PORT=8092
NEMO_SPEECH_FLAVOR=cuda
NEMO_ASR_MODEL=nemotron-3.5-asr-streaming-0.6b.q8_0.gguf
NEMO_DEVICE=cuda
# Äußerungstrennung (Stille in ms bis ein Abschnitt final wird); 700 im Test bewährt
NEMO_ENDPOINTING_MS=700
# Sprechertrennung: NEMO_DIAR_ARGS=
# Sprecherlabels im Adapter anfordern (nur mit geladenem Diarization-Modell sinnvoll)
NEMO_SPEAKER_DIARIZATION=false--diar-model /models/Nemotron-3-Diarization.q8_0.gguf
NEMO_DIAR_ARGS=
NEMO_PORT=8095
ADAPTER_PORT=8765
